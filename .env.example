# Set these in Cloudflare Pages > Settings > Environment variables (never commit real values).
TEAM_KEY=choose-a-long-random-string
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
# Any OpenAI-compatible endpoint (Groq, Together, Fireworks, OpenRouter...)
