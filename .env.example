# Set these in Cloudflare Pages > Settings > Environment variables (never commit real values).
# TEAM_KEY is OPTIONAL: leave it unset and the chat opens with no key screen (API is open).
# Set a long random string to require the key (the page then shows a key screen once).
TEAM_KEY=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
# Any OpenAI-compatible endpoint (Groq, Together, Fireworks, OpenRouter...)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=your-llm-api-key
