# Set these in Cloudflare Pages > Settings > Environment variables (never commit real values).
# There is no TEAM_KEY: the chat is open to anyone with the link.
# Protect it with Cloudflare Access and a rate limiting rule on /api/* (see README).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
# Any OpenAI-compatible endpoint (Groq, Together, Fireworks, OpenRouter...)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=your-llm-api-key
# Optional: locks POST/DELETE /api/docs and POST /api/backfill behind a Bearer key.
# The crawler's TEAM_KEY secret must be the same value. Leave unset = open.
ADMIN_KEY=a-long-random-string
