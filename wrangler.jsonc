// ReplyGPT as a single Worker: static files from public/ plus the API.
// Deployed automatically by Cloudflare's Git integration.
{
  "name": "replygpt",
  "main": "functions/api/[[route]].ts",
  "compatibility_date": "2025-11-01",
  // Non-secret settings. SUPABASE_SERVICE_KEY and LLM_API_KEY are Secrets,
  // set in the Cloudflare dashboard only (never in this file).
  "vars": {
    "SUPABASE_URL": "https://ecmdabbhyujwgetqqzrq.supabase.co",
    "LLM_BASE_URL": "https://api.groq.com/openai/v1",
    "LLM_MODEL": "openai/gpt-oss-120b"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
